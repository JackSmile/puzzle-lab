  "baseFormulas": {
    "life": {
      "constantAtLevelZero": 38,
      "perLevel": 12,
      "perStrength": 0.5,
      "formula": "38 + 12 * level + strength / 2",
      "levelOneWithoutStrength": 50,
      "sourceKeys": [
        "Life"
      ]
    },
    "mana": {
      "constantAtLevelZero": 34,
      "perLevel": 6,
      "perIntelligence": 0.5,
      "formula": "34 + 6 * level + intelligence / 2",
      "levelOneWithoutIntelligence": 40,
      "regenerationFractionPerSecond": 0.018,
      "sourceKeys": [
        "Mana"
      ]
    },
    "accuracy": {
      "perLevel": 2,
      "perDexterity": 2,
      "formula": "2 * level + 2 * dexterity",
      "sourceKeys": [
        "Accuracy",
        "Character"
      ]
    },
    "evasion": {
      "base": 15,
      "perLevel": 0,
      "dexterityIncreasedPercentPerFive": 1,
      "formulaWithoutOtherModifiers": "15 * (1 + ceil(dexterity / 5) / 100)",
      "sourceKeys": [
        "Evasion"
      ],
      "roundingCaveat": "Evasion page says Dexterity rounds up to the nearest multiple of 5 for this increased percentage. Final displayed evasion integer rounding not independently verified."
    },
    "lifeAndManaRoundingCaveat": "Formulas preserve halves from odd attributes. Final integer rounding is not documented by the fetched pages; do not claim exact displayed integer without additional verification."
